@echo off
title VIctory / rodrion-vi - Pre-Compile AMD Shaders and Pipelines
powershell -NoProfile -ExecutionPolicy Bypass -Command "$repo='%~dp0'.TrimEnd('\'); Set-Location $repo; $toml=Join-Path $repo 'victory.toml'; if (-not (Test-Path $toml)) { Write-Host 'victory.toml not found. Copy victory.example.toml to victory.toml and set your paths.' -ForegroundColor Red; exit 1 }; $cfg=Get-Content $toml -Raw; $gameDir=if ($cfg -match 'game_dir\s*=\s*\"([^\"]+)\"') { $matches[1] } else { '' }; $cacheDir=if ($cfg -match 'cache_dir\s*=\s*\"([^\"]+)\"') { $matches[1] } else { '' }; if (-not $gameDir -or -not (Test-Path (Join-Path $gameDir 'shaders.rpf'))) { Write-Host 'shaders.rpf not found in game_dir from victory.toml' -ForegroundColor Red; exit 1 }; $env:VICTORY_CONFIG=$toml; $env:VICTORY_SHADER_OPT='0'; $skipFile=Join-Path $repo 'docs\klbf\skip-amd.txt'; if (Test-Path $skipFile) { $env:VICTORY_SKIP_PIPELINES=(Get-Content $skipFile -Raw).Trim() } else { $env:VICTORY_SKIP_PIPELINES='39f0e9aeb156a61c' }; $attempt=1; while ($attempt -le 25) { Write-Host \"=== Pass $attempt - Pre-compiling AMD shaders and pipelines (8 threads) ===\" -ForegroundColor Cyan; .\target\release\victory.exe translate --cache --pipelines --jobs 8 (Join-Path $gameDir 'shaders.rpf'); if ($LASTEXITCODE -eq 0) { if ($cacheDir) { New-Item -ItemType File -Force -Path (Join-Path $cacheDir 'precompiled.ok') | Out-Null }; Write-Host 'DONE! All shaders and pipelines pre-compiled into cache!' -ForegroundColor Green; break }; Write-Host 'AMD driver skipped a problematic pipeline (saved to prebuild-crashed.txt), resuming automatically...' -ForegroundColor Yellow; $attempt++ }"
pause
